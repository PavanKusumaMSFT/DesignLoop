{
  "$description": "Project Cirrus typography primitives. Monospace-first (terminal cells); UI stack for chrome/badges.",
  "font-family": {
    "mono": "ui-monospace, SFMono-Regular, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', 'Fira Code', Menlo, Consolas, 'Liberation Mono', monospace",
    "ui": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
  },
  "font-size": {
    "2xs": "0.6875rem",
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "base": "0.875rem",
    "md": "1rem",
    "lg": "1.125rem"
  },
  "font-weight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "line-height": {
    "tight": 1.2,
    "snug": 1.35,
    "normal": 1.5,
    "relaxed": 1.7
  },
  "usage": {
    "terminal-body": { "font-family": "mono", "font-size": "base", "line-height": "tight" },
    "ghost-text": { "font-family": "mono", "font-size": "base", "font-weight": "normal" },
    "param-flag": { "font-family": "mono", "font-size": "base", "font-weight": "medium" },
    "suggestion-item": { "font-family": "mono", "font-size": "sm", "line-height": "snug" },
    "resource-meta": { "font-family": "mono", "font-size": "xs" },
    "hint-line": { "font-family": "ui", "font-size": "xs", "line-height": "relaxed" },
    "badge": { "font-family": "ui", "font-size": "2xs", "font-weight": "semibold" }
  }
}
