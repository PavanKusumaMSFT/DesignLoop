# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Editor
.idea/
*.swp

# Prototype workspace outputs
prototype-workspace/node_modules/
prototype-workspace/.next/
prototype-workspace/storybook-static/
prototype-workspace/out/

# Shares Functions API (local only)
prototype-workspace/api/node_modules/
prototype-workspace/api/local.settings.json

# Local environment files (never commit — values are injected via CI variables)
prototype-workspace/.env.local
prototype-workspace/.env*.local

# Locally-created prototypes registry (per-user, not part of the live repo baseline)
prototype-workspace/public/local-prototypes.json

# Bridge runtime state (per-user Figma send targets, etc.)
bridge/data/

# Temporary version-preview mirrors materialised by the bridge for the task
# page's "view a past version" selector (checked-out snapshots of past commits)
prototype-workspace/app/vpr__*
prototype-workspace/components/projects/vpr__*

# Tasks are LOCAL by default — a newly created task stays on the user's machine
# and is never swept into a commit by `git add .`. Sharing a task publishes it on
# its own `task/<id>` branch via the bridge (force-add in an isolated worktree).
# Baseline example tasks already tracked in the repo are unaffected (ignoring
# untracked paths does not untrack committed files).
/tasks/*
!/tasks/.gitkeep
