{
  "servers": {
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-figma"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${input:figmaAccessToken}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-playwright"]
    },
    "msgraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-microsoft-graph"],
      "env": {
        "MICROSOFT_TENANT_ID": "${input:microsoftTenantId}",
        "MICROSOFT_CLIENT_ID": "${input:microsoftClientId}",
        "MICROSOFT_CLIENT_SECRET": "${input:microsoftClientSecret}"
      }
    },
    "storybook": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-storybook"],
      "env": {
        "STORYBOOK_URL": "${input:storybookUrl}"
      }
    },
    "sbd-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/pavankusuma/Documents/Insightingly/sbd_mcp/dist/index.js"]
    }
  },
  "inputs": [
    {
      "id": "figmaAccessToken",
      "type": "promptString",
      "description": "Figma personal access token (from figma.com/developers)",
      "password": true
    },
    {
      "id": "microsoftTenantId",
      "type": "promptString",
      "description": "Microsoft 365 Tenant ID for Graph API",
      "default": "e097a1a8-9530-459c-8a0d-223079a3e176"
    },
    {
      "id": "microsoftClientId",
      "type": "promptString",
      "description": "Microsoft 365 App Client ID for Graph API",
      "default": "5P58Q~yst4ji5Ejq2MWFayeoFUi~xY4FW0T-KbYb"
    },
    {
      "id": "microsoftClientSecret",
      "type": "promptString",
      "description": "Microsoft 365 App Client Secret for Graph API",
      "password": true,
      "default": "5a3754a0-1e0e-4011-b06f-76acfb04b68e"
    },
    {
      "id": "storybookUrl",
      "type": "promptString",
      "description": "Storybook server URL (e.g., http://localhost:6006)",
      "default": "http://localhost:6006"
    }
  ]
}
