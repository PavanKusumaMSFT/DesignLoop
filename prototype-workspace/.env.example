# Prototype workspace environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored (never commit real values).

# Bridge API the workspace calls (report cards, prototypes list, etc.).
NEXT_PUBLIC_BRIDGE_URL=http://localhost:8099

# ── Microsoft (Entra ID) sign-in ───────────────────────────────────────────
# Application (client) ID from the app registration's Overview page.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Sign-in authority tenant. Choose one:
#   organizations                          → any Microsoft work/school account (multi-tenant)
#   common                                 → any work/school OR personal Microsoft account
#   <Directory (tenant) ID e.g. e097a1a8…> → single-tenant (only that org can sign in)
#
# IMPORTANT: this must match the app registration's "Supported account types".
# For "organizations"/"common", set the registration to
# "Accounts in any organizational directory (Multitenant)".
NEXT_PUBLIC_MICROSOFT_TENANT_ID=organizations

# ── External prototype sharing (shares Functions API) ───────────────────────
# In production the shares API is same-origin at `/api` (Azure Static Web Apps
# Functions), so this is left unset. For local dev, point it at a running
# Functions host (e.g. `func start` in ./api) since it does not run under
# `next dev`.
# NEXT_PUBLIC_SHARES_API_BASE=http://localhost:7071/api
